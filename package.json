{
  "name": "financial-validator-backend",
  "version": "3.0.0",
  "description": "Financial research report validator — Groq + Tavily + SEC EDGAR + PDF support",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev":   "nodemon src/server.js",
    "test":  "jest --testTimeout=35000"
  },
  "dependencies": {
    "cors":       "^2.8.5",
    "dotenv":     "^16.4.5",
    "express":    "^4.19.2",
    "groq-sdk":   "^0.9.0",
    "multer":     "^1.4.5-lts.1",
    "pdf-parse":  "^1.1.1"
  },
  "devDependencies": {
    "jest":      "^29.7.0",
    "nodemon":   "^3.1.4",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": ["**/tests/**/*.test.js"]
  }
}
