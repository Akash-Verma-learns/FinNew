# ── LLM ───────────────────────────────────────────────
# Free tier at https://console.groq.com
# Create an API key under "API Keys" in the dashboard
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Web Search ─────────────────────────────────────────
# Free tier (1000 searches/month) at https://app.tavily.com
# Create an API key under "API Keys" in your Tavily dashboard
TAVILY_API_KEY=tvly-your_tavily_api_key_here

# ── Server (optional) ──────────────────────────────────
# Default: 8000
# PORT=8000
